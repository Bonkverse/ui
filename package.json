{
  "name": "@bonkverse/ui",
  "version": "0.1.0",
  "description": "The shared look of the Bonkverse sites: color tokens for three themes, Jost, base styles and components. Plain CSS, no build step.",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:Bonkverse/ui",
  "homepage": "https://bonkverse.github.io/ui/",
  "type": "module",
  "files": [
    "tokens.css",
    "base.css",
    "components.css",
    "theme.js",
    "ui.js",
    "nav.json",
    "fonts/",
    "img/planet.png"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./components.css": "./components.css",
    "./theme.js": "./theme.js",
    "./ui.js": "./ui.js",
    "./nav.json": "./nav.json",
    "./fonts/*": "./fonts/*",
    "./img/*": "./img/*"
  },
  "scripts": {
    "check": "node scripts/contrast.mjs --failing && node scripts/check-version.mjs",
    "contrast": "node scripts/contrast.mjs",
    "responsive": "node scripts/responsive.mjs",
    "gallery": "python3 -m http.server 8000"
  }
}
